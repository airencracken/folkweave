[Unit]
Description=Folkweave private timeline
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=folkweave
Group=folkweave
WorkingDirectory=/var/lib/folkweave
StateDirectory=folkweave
StateDirectoryMode=0700
EnvironmentFile=-/etc/folkweave/folkweave.env
ExecStart=/usr/local/bin/folkweave serve
Restart=on-failure
StandardOutput=journal
StandardError=journal
SyslogIdentifier=folkweave
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/folkweave
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
