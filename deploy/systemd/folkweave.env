# systemd configuration: /etc/folkweave/folkweave.env
# Use KEY="value" for every setting; no export statements are needed.
# OpenRC uses /etc/conf.d/folkweave instead.

FOLKWEAVE_DATA_DIR="/var/lib/folkweave"
FOLKWEAVE_LISTEN="127.0.0.1:8084"
# Set these before exposing the service through your HTTPS reverse proxy:
# FOLKWEAVE_BASE_URL="https://folkweave.example.org"
# FOLKWEAVE_TRUSTED_PROXIES="127.0.0.1/32,::1/128"
FOLKWEAVE_BACKUP_INTERVAL="24h"
FOLKWEAVE_BACKUP_KEEP="7"

# Optional suite links and explicitly linked community sign-in; see docs/suite.md.
# FOLKWEAVE_APPS=""
# FOLKWEAVE_SHARED_ISSUER=""
# FOLKWEAVE_SHARED_CLIENT_ID=""
# FOLKWEAVE_SHARED_CLIENT_SECRET=""
