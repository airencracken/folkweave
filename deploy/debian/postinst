#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
case "$1" in
	configure)
		if ! getent group folkweave >/dev/null; then
			addgroup --system folkweave || exit 1
		fi
		if ! getent passwd folkweave >/dev/null; then
			adduser --system --ingroup folkweave --home /var/lib/folkweave \
				--no-create-home --shell /usr/sbin/nologin folkweave || exit 1
		fi
		if [ "$(id -u folkweave)" = 0 ] || [ "$(getent group folkweave | cut -d: -f3)" = 0 ]; then
			echo 'Refusing to run Folkweave with a root service account or group.' >&2
			exit 1
		fi
		install -d -o folkweave -g folkweave -m 0700 /var/lib/folkweave || exit 1
		if [ -d /run/systemd/system ]; then
			systemctl daemon-reload || exit 1
			# Restart an already-running instance on upgrade; never start or enable
			# a new installation before the operator has configured it.
			deb-systemd-invoke try-restart folkweave.service || exit 1
		fi
		;;
esac
exit 0
